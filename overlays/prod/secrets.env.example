# goa-secrets değerleri (prod). secrets.env olarak kopyalayıp gerçek değerleri yazın; secrets.env git'e girmez.
# Buradaki değerler yalnızca örnektir. Kalıcı çözüm için README > Secret yönetimi.

POSTGRES_PASSWORD=changeme
REDIS_PASSWORD=changeme
# Java servisleri ve Go savaş sunucusu aynı değeri kullanır.
INTERNAL_API_TOKEN=change-me-internal-token
# Boşsa Gemini çağrılmaz, yedek isim listesi kullanılır.
GEMINI_API_KEY=
# İlk admin (yalnızca ilk eklemede). Boşsa admin eklenmez.
GOA_ADMIN_USERNAME=
GOA_ADMIN_EMAIL=
GOA_ADMIN_PASSWORD=
