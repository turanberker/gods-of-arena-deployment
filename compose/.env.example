# .env olarak kopyalayıp gerçek değerleri yazın; .env git'e girmez.
#   cp .env.example .env && chmod 600 .env
# Rastgele parola üretmek için: openssl rand -base64 32 | tr -d '/+='

# ── Alan adları ve Let's Encrypt ─────────────────────────────
GOA_DOMAIN=goa.amateurtennisleague.com
GOA_ADMIN_DOMAIN=admin.goa.amateurtennisleague.com
# Sertifika süresi dolmak üzereyken Let's Encrypt buraya yazar.
ACME_EMAIL=

# ── Parolalar (zorunlu) ──────────────────────────────────────
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# Java servisleri ve Go savaş sunucusu aynı değeri kullanır.
INTERNAL_API_TOKEN=

# ── İlk admin (yalnızca ilk açılışta eklenir; boşsa eklenmez) ─
GOA_ADMIN_USERNAME=
GOA_ADMIN_EMAIL=
GOA_ADMIN_PASSWORD=

# ── İsteğe bağlı ─────────────────────────────────────────────
# Boşsa Gemini çağrılmaz, yedek isim listesi kullanılır.
GEMINI_API_KEY=
# Docker Hub etiketi. Geri alınabilir kurulum için sabit etiket önerilir: sha-1f67886
IMAGE_TAG=latest
# Java servisi başına bellek sınırı (5 servis). 1 GB'lık makinede çalışmaz; README > Sunucu boyutu.
JAVA_MEM_LIMIT=512m
# Başka bir proxy 80/443'ü kullanıyorsa: README > 80/443 başka bir uygulamadaysa.
HTTP_PORT=80
HTTPS_PORT=443
